{#
| Variable                       | Type     | Description
|--------------------------------|----------|----------------------------------------------|
| component                      | object   | Merchant settings from twilight.json         |
| component.slides[].image       | string   | Image URL                                    |
| component.slides[].title       | ?string  | Slide title                                  |
| component.slides[].description | ?string  | Slide description                            |
| component.slides[].url         | ?string  | Primary button link                          |
| component.slides[].btnname     | ?string  | Primary button text                          |
| component.slides               | object[] | Slides list                                  |
| position                       | int      | Sorting number                               |
#}

<section
  data-testid="store-home-slider"
  class="s-block s-block--hero-slider apex-hero-slider"
>
  <salla-slider
    id="main-slider-{{ position }}"
    auto-play
    static-when-single
    slider-config='{"lazy":false,"speed":700}'
    {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
    type="fullwidth"
  >
    <div slot="items">
      {% for slide in component.slides %}
        <div class="swiper-slide apex-hero-slide">
          
          <div
            class="apex-hero-slide__background {{ slide.without_overlay ? '' : 'apex-hero-slide__overlay' }}"
            style="background-image: url('{{ slide.image }}');"
          ></div>

          <div class="container apex-hero-slide__container">
            <div class="apex-hero-slide__content">

              {% if slide.title %}
                <h2
                  data-swiper-parallax="-500"
                  class="apex-hero-slide__title"
                >
                  {{ slide.title }}
                </h2>
              {% endif %}

              {% if slide.description %}
                <p
                  data-swiper-parallax="-300"
                  class="apex-hero-slide__description"
                >
                  {{ slide.description }}
                </p>
              {% endif %}

              <div class="apex-hero-slide__actions">
                <a
                  href="{{ slide.url ?: '#' }}"
                  class="apex-btn apex-btn--primary"
                >
                  {{ slide.btnname ?: 'تسوق الآن' }}
                </a>

                <a
                  href="/pages/build-your-pc"
                  class="apex-btn apex-btn--secondary"
                >
                  ابنِ تجميعتك
                </a>
              </div>

              <div class="apex-hero-slide__features">
                <span>ضمان موثوق</span>
                <span>توصيل سريع</span>
                <span>دعم فني متخصص</span>
              </div>

            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </salla-slider>
</section>
{#
  ==========================================================================
  APEX PC — صفحة «ابنِ تجميعتك»
  المسار الصحيح للملف:  src/views/components/pc-builder.twig
  --------------------------------------------------------------------------
  كل اللي تحتاج تعدّله موجود في بلوك JSON بالأسفل مباشرة (apex-parts-data).
  لا تعدّل شي غيره إلا لو تبي تغيّر الشكل.
  ==========================================================================
#}

{# ==========  ١) بيانات القطع — عدّل هنا فقط  ========== #}
{#
  شرح الحقول:
  id      : رقم المنتج في سلة (Product ID) — تجيبه من رابط المنتج أو لوحة التحكم
  type    : cpu | motherboard | ram | gpu | storage | psu | case | cooler
  name    : اسم المنتج كما تبي يظهر
  price   : السعر بالريال (رقم فقط)
  img     : رابط صورة المنتج (اختياري)
  brand   : الماركة (اختياري — تظهر كوسم)

  حقول المواصفات حسب النوع:
  cpu         : socket, tdp, igpu (true/false)
  motherboard : socket, ram_type, ram_slots, form (ATX|mATX|ITX)
  ram         : ram_type, modules, watt
  gpu         : length (مم), watt
  storage     : watt
  psu         : watt (قدرة المزود)
  case        : forms (مصفوفة المقاسات المدعومة), max_gpu (مم), max_cooler (مم)
  cooler      : sockets (مصفوفة), height (مم), watt
#}

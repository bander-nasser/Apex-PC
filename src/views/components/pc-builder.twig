{# ==========  ٢) الواجهة  ========== #}
<section id="apex-builder" dir="rtl">

  <header class="axb-head">
    <div class="axb-head__text">
      <span class="axb-kicker">APEX PC</span>
      <h1 class="axb-title">ابنِ تجميعتك</h1>
      <p class="axb-sub">اختر قطعك خطوة بخطوة — ونحن نتأكد من التوافق نيابةً عنك.</p>
    </div>

    <div class="axb-progress" role="status" aria-live="polite">
      <svg viewBox="0 0 44 44" class="axb-ring" aria-hidden="true">
        <circle class="axb-ring__bg" cx="22" cy="22" r="19"></circle>
        <circle class="axb-ring__fg" cx="22" cy="22" r="19" id="axb-ring-fg"></circle>
      </svg>
      <div>
        <strong id="axb-progress-count">0 / 8</strong>
        <span>قطعة مختارة</span>
      </div>
    </div>
  </header>

  <div class="axb-layout">

    {# --- قائمة الخانات --- #}
    <div class="axb-slots" id="axb-slots"></div>

    {# --- الملخّص --- #}
    <aside class="axb-summary">
      <div class="axb-summary__inner">

        <div class="axb-power">
          <div class="axb-power__top">
            <span>استهلاك الطاقة المقدّر</span>
            <strong id="axb-watt">0 واط</strong>
          </div>
          <div class="axb-power__bar"><span id="axb-watt-bar"></span></div>
          <small id="axb-watt-note">اختر مزود طاقة لمعرفة الكفاية</small>
        </div>

        <div class="axb-issues" id="axb-issues"></div>

        <div class="axb-total">
          <span>الإجمالي</span>
          <strong id="axb-total">0 ر.س</strong>
        </div>

        <button type="button" class="axb-cta" id="axb-add-all" disabled>
          أضف التجميعة للسلة
        </button>

        <button type="button" class="axb-reset" id="axb-reset">تفريغ التجميعة</button>

        <p class="axb-note">الأسعار شاملة القطع المختارة فقط. التركيب والاختبار يُضافان عند إتمام الطلب.</p>
      </div>
    </aside>
  </div>

  {# --- نافذة الاختيار --- #}
  <div class="axb-modal" id="axb-modal" hidden>
    <div class="axb-modal__backdrop" data-axb-close></div>
    <div class="axb-modal__panel" role="dialog" aria-modal="true" aria-labelledby="axb-modal-title">
      <header class="axb-modal__head">
        <h2 id="axb-modal-title">اختر القطعة</h2>
        <button type="button" class="axb-modal__close" data-axb-close aria-label="إغلاق">&times;</button>
      </header>
      <div class="axb-modal__filters">
        <input type="search" id="axb-search" placeholder="ابحث بالاسم أو الماركة…" />
        <label class="axb-switch">
          <input type="checkbox" id="axb-only-compatible" checked />
          <span>المتوافق فقط</span>
        </label>
      </div>
      <div class="axb-modal__list" id="axb-modal-list"></div>
    </div>
  </div>
</section>

{# ==========  ٣) التنسيق  ========== #}
<style>
#apex-builder{
  --axb-bg:#0A0C11;
  --axb-panel:#12161F;
  --axb-panel-2:#171C27;
  --axb-line:#242C3A;
  --axb-text:#E8ECF3;
  --axb-muted:#8D97AA;
  --axb-accent:#00D6FF;
  --axb-accent-2:#7C5CFF;
  --axb-ok:#2ED8A7;
  --axb-warn:#FFB020;
  --axb-err:#FF5C72;
  --axb-radius:16px;

  background:var(--axb-bg);
  color:var(--axb-text);
  padding:48px 20px 72px;
  font-family:inherit;
  line-height:1.6;
}
#apex-builder *{box-sizing:border-box}

/* ——— الترويسة ——— */
.axb-head{
  max-width:1240px;margin:0 auto 40px;
  display:flex;flex-wrap:wrap;gap:24px;
  align-items:flex-end;justify-content:space-between;
}
.axb-kicker{
  display:inline-block;font-size:12px;letter-spacing:.24em;
  color:var(--axb-accent);margin-bottom:10px;
}
.axb-title{
  font-size:clamp(30px,5vw,46px);margin:0 0 8px;font-weight:800;
  background:linear-gradient(90deg,var(--axb-text),var(--axb-accent));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.axb-sub{margin:0;color:var(--axb-muted);max-width:46ch}

.axb-progress{display:flex;align-items:center;gap:14px}
.axb-progress strong{display:block;font-size:19px}
.axb-progress span{font-size:13px;color:var(--axb-muted)}
.axb-ring{width:52px;height:52px;transform:rotate(-90deg)}
.axb-ring circle{fill:none;stroke-width:4;stroke-linecap:round}
.axb-ring__bg{stroke:var(--axb-line)}
.axb-ring__fg{
  stroke:var(--axb-accent);stroke-dasharray:119.4;stroke-dashoffset:119.4;
  transition:stroke-dashoffset .5s cubic-bezier(.4,0,.2,1);
}

/* ——— التخطيط ——— */
.axb-layout{
  max-width:1240px;margin:0 auto;
  display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start;
}
@media (max-width:900px){ .axb-layout{grid-template-columns:1fr} }

/* ——— خانات القطع ——— */
.axb-slots{display:grid;gap:12px}
.axb-slot{
  display:flex;align-items:center;gap:16px;width:100%;text-align:right;
  background:var(--axb-panel);border:1px solid var(--axb-line);
  border-radius:var(--axb-radius);padding:16px 18px;cursor:pointer;
  transition:border-color .2s, transform .2s, background .2s;
}
.axb-slot:hover{border-color:var(--axb-accent);transform:translateX(-3px)}
.axb-slot.is-filled{background:var(--axb-panel-2)}
.axb-slot.has-error{border-color:var(--axb-err)}

.axb-slot__icon{
  width:46px;height:46px;flex:0 0 46px;border-radius:12px;
  display:grid;place-items:center;font-size:20px;
  background:linear-gradient(140deg,rgba(0,214,255,.16),rgba(124,92,255,.16));
  border:1px solid var(--axb-line);
}
.axb-slot__body{flex:1;min-width:0}
.axb-slot__label{font-size:12px;color:var(--axb-muted);display:block}
.axb-slot__name{
  font-weight:600;font-size:15px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.axb-slot__name.is-empty{color:var(--axb-muted);font-weight:400}
.axb-slot__meta{font-size:12px;color:var(--axb-muted);margin-top:2px}
.axb-slot__price{font-weight:700;font-size:15px;white-space:nowrap}
.axb-slot__thumb{
  width:46px;height:46px;object-fit:contain;border-radius:10px;
  background:#0E1219;border:1px solid var(--axb-line);
}
.axb-slot__clear{
  background:none;border:none;color:var(--axb-muted);cursor:pointer;
  font-size:18px;line-height:1;padding:6px;border-radius:8px;
}
.axb-slot__clear:hover{color:var(--axb-err);background:rgba(255,92,114,.1)}

/* ——— الملخص ——— */
.axb-summary__inner{
  position:sticky;top:20px;
  background:var(--axb-panel);border:1px solid var(--axb-line);
  border-radius:var(--axb-radius);padding:22px;
}
.axb-power__top{display:flex;justify-content:space-between;font-size:13px;color:var(--axb-muted)}
.axb-power__top strong{color:var(--axb-text);font-size:15px}
.axb-power__bar{
  height:7px;border-radius:99px;background:var(--axb-line);
  margin:10px 0 8px;overflow:hidden;
}
.axb-power__bar span{
  display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,var(--axb-ok),var(--axb-accent));
  transition:width .45s ease, background .3s;
}
.axb-power__bar.is-tight span{background:linear-gradient(90deg,var(--axb-warn),#FF8A3D)}
.axb-power__bar.is-over span{background:linear-gradient(90deg,var(--axb-err),#FF2D55)}
.axb-power small{font-size:12px;color:var(--axb-muted)}

.axb-issues{margin:18px 0}
.axb-issue{
  display:flex;gap:9px;font-size:13px;padding:10px 12px;
  border-radius:11px;margin-bottom:8px;line-height:1.5;
}
.axb-issue--err{background:rgba(255,92,114,.1);color:#FFB3BE;border:1px solid rgba(255,92,114,.25)}
.axb-issue--warn{background:rgba(255,176,32,.1);color:#FFD79B;border:1px solid rgba(255,176,32,.25)}
.axb-issue--ok{background:rgba(46,216,167,.1);color:#9BEBD3;border:1px solid rgba(46,216,167,.25)}

.axb-total{
  display:flex;justify-content:space-between;align-items:baseline;
  padding-top:16px;border-top:1px solid var(--axb-line);margin-bottom:16px;
}
.axb-total span{color:var(--axb-muted);font-size:14px}
.axb-total strong{font-size:26px;font-weight:800}

.axb-cta{
  width:100%;padding:15px;border:none;border-radius:13px;cursor:pointer;
  font-size:16px;font-weight:700;color:#04121A;font-family:inherit;
  background:linear-gradient(100deg,var(--axb-accent),var(--axb-accent-2));
  transition:filter .2s, transform .15s;
}
.axb-cta:hover:not(:disabled){filter:brightness(1.12);transform:translateY(-1px)}
.axb-cta:disabled{opacity:.35;cursor:not-allowed}
.axb-cta.is-loading{pointer-events:none;opacity:.7}

.axb-reset{
  width:100%;margin-top:10px;padding:11px;background:none;cursor:pointer;
  border:1px solid var(--axb-line);border-radius:11px;
  color:var(--axb-muted);font-size:13px;font-family:inherit;
}
.axb-reset:hover{color:var(--axb-err);border-color:var(--axb-err)}
.axb-note{font-size:11.5px;color:var(--axb-muted);margin:14px 0 0;line-height:1.6}

/* ——— النافذة ——— */
.axb-modal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:20px}
.axb-modal[hidden]{display:none}
.axb-modal__backdrop{position:absolute;inset:0;background:rgba(4,6,10,.78);backdrop-filter:blur(4px)}
.axb-modal__panel{
  position:relative;width:min(760px,100%);max-height:86vh;display:flex;flex-direction:column;
  background:var(--axb-panel);border:1px solid var(--axb-line);
  border-radius:20px;overflow:hidden;
  animation:axb-in .25s cubic-bezier(.2,.8,.2,1);
}
@keyframes axb-in{from{opacity:0;transform:translateY(14px) scale(.98)}}
.axb-modal__head{
  display:flex;justify-content:space-between;align-items:center;
  padding:18px 22px;border-bottom:1px solid var(--axb-line);
}
.axb-modal__head h2{margin:0;font-size:18px}
.axb-modal__close{background:none;border:none;color:var(--axb-muted);font-size:28px;cursor:pointer;line-height:1}
.axb-modal__close:hover{color:var(--axb-text)}
.axb-modal__filters{
  display:flex;gap:14px;align-items:center;flex-wrap:wrap;
  padding:14px 22px;border-bottom:1px solid var(--axb-line);
}
#axb-search{
  flex:1;min-width:180px;padding:10px 14px;border-radius:10px;font-family:inherit;
  background:var(--axb-bg);border:1px solid var(--axb-line);color:var(--axb-text);
}
#axb-search:focus{outline:none;border-color:var(--axb-accent)}
.axb-switch{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--axb-muted);cursor:pointer}
.axb-modal__list{overflow-y:auto;padding:12px}

.axb-option{
  display:flex;align-items:center;gap:14px;width:100%;text-align:right;
  padding:13px 15px;border-radius:13px;cursor:pointer;font-family:inherit;
  background:transparent;border:1px solid transparent;color:inherit;
  transition:background .18s, border-color .18s;
}
.axb-option:hover:not(:disabled){background:var(--axb-panel-2);border-color:var(--axb-line)}
.axb-option:disabled{opacity:.4;cursor:not-allowed}
.axb-option__thumb{
  width:52px;height:52px;flex:0 0 52px;object-fit:contain;border-radius:10px;
  background:#0E1219;border:1px solid var(--axb-line);
}
.axb-option__body{flex:1;min-width:0}
.axb-option__name{font-weight:600;font-size:14.5px}
.axb-option__spec{font-size:12px;color:var(--axb-muted);margin-top:3px}
.axb-option__reason{font-size:12px;color:var(--axb-err);margin-top:3px}
.axb-option__price{font-weight:700;white-space:nowrap}
.axb-empty{text-align:center;color:var(--axb-muted);padding:40px 20px;font-size:14px}
</style>

{# ==========  ٤) المحرّك  ========== #}
<script>
(function () {
  var root = document.getElementById('apex-builder');
  if (!root) return;

  // ---------- تعريف الخانات ----------
  var SLOTS = [
    { type: 'cpu',         label: 'المعالج',        icon: '⬛' },
    { type: 'motherboard', label: 'اللوحة الأم',    icon: '▤' },
    { type: 'ram',         label: 'الذاكرة (RAM)',  icon: '▥' },
    { type: 'gpu',         label: 'كرت الشاشة',     icon: '◨' },
    { type: 'storage',     label: 'التخزين',        icon: '◍' },
    { type: 'psu',         label: 'مزود الطاقة',    icon: '⚡' },
    { type: 'case',        label: 'الكيس',          icon: '▣' },
    { type: 'cooler',      label: 'التبريد',        icon: '❄' }
  ];

  var PARTS = [];
  try {
    PARTS = JSON.parse(document.getElementById('apex-parts-data').textContent);
  } catch (e) {
    console.error('[ApexBuilder] خطأ في قراءة بيانات القطع:', e);
  }

  var build = {};          // { type: part }
  var activeType = null;   // نوع الخانة المفتوحة في النافذة
  var STORAGE_KEY = 'apex_build_v1';

  // ---------- أدوات ----------
  function money(n) {
    return new Intl.NumberFormat('ar-SA', { maximumFractionDigits: 0 }).format(n) + ' ر.س';
  }
  function byType(t) { return PARTS.filter(function (p) { return p.type === t; }); }
  function fallbackImg(p) {
    return p.img || 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52"><rect width="52" height="52" fill="%230E1219"/><text x="26" y="32" font-size="18" text-anchor="middle" fill="%23404A5C">▢</text></svg>'
    );
  }

  // ---------- محرّك التوافق ----------
  // يرجع سبب عدم التوافق بين قطعة مرشحة والتجميعة الحالية، أو null لو متوافقة.
  function incompatibleReason(part, current) {
    var cpu = current.cpu, mb = current.motherboard, ram = current.ram,
        gpu = current.gpu, cs = current.case, cooler = current.cooler;

    if (part.type === 'cpu') {
      if (mb && mb.socket !== part.socket) return 'لا يناسب سوكت اللوحة (' + mb.socket + ')';
      if (cooler && cooler.sockets && cooler.sockets.indexOf(part.socket) === -1)
        return 'المبرد المختار لا يدعم سوكت ' + part.socket;
    }
    if (part.type === 'motherboard') {
      if (cpu && cpu.socket !== part.socket) return 'لا تناسب سوكت المعالج (' + cpu.socket + ')';
      if (ram && ram.ram_type !== part.ram_type) return 'لا تدعم ذاكرة ' + ram.ram_type;
      if (ram && ram.modules > part.ram_slots) return 'عدد فتحات الذاكرة غير كافٍ';
      if (cs && cs.forms && cs.forms.indexOf(part.form) === -1) return 'مقاس ' + part.form + ' لا يدخل في الكيس المختار';
    }
    if (part.type === 'ram') {
      if (mb && mb.ram_type !== part.ram_type) return 'اللوحة تدعم ' + mb.ram_type + ' فقط';
      if (mb && part.modules > mb.ram_slots) return 'عدد القطع أكبر من فتحات اللوحة';
    }
    if (part.type === 'gpu') {
      if (cs && cs.max_gpu && part.length > cs.max_gpu)
        return 'أطول من مساحة الكيس (' + cs.max_gpu + ' مم)';
    }
    if (part.type === 'case') {
      if (mb && part.forms && part.forms.indexOf(mb.form) === -1) return 'لا يستوعب لوحة ' + mb.form;
      if (gpu && part.max_gpu && gpu.length > part.max_gpu) return 'أصغر من طول كرت الشاشة المختار';
      if (cooler && part.max_cooler && cooler.height > part.max_cooler) return 'أقصر من ارتفاع المبرد المختار';
    }
    if (part.type === 'cooler') {
      if (cpu && part.sockets && part.sockets.indexOf(cpu.socket) === -1)
        return 'لا يدعم سوكت ' + cpu.socket;
      if (cs && cs.max_cooler && part.height > cs.max_cooler)
        return 'أعلى من ارتفاع الكيس (' + cs.max_cooler + ' مم)';
    }
    if (part.type === 'psu') {
      var need = Math.round(estimateWatt(current) * 1.3);
      if (need > part.watt) return 'قدرته أقل من احتياج التجميعة (' + need + ' واط)';
    }
    return null;
  }

  function estimateWatt(state) {
    var w = 60; // اللوحة والمراوح والأساسيات
    Object.keys(state).forEach(function (k) {
      if (k === 'psu') return;
      var p = state[k];
      if (!p) return;
      w += p.tdp || p.watt || 0;
    });
    return w;
  }

  // ---------- التحقق الشامل ----------
  function collectIssues() {
    var out = [];
    var need = Math.round(estimateWatt(build) * 1.3);

    // نواقص
    var missing = SLOTS.filter(function (s) { return !build[s.type]; });
    var essential = ['cpu', 'motherboard', 'ram', 'storage', 'psu', 'case'];
    var missingEssential = missing.filter(function (s) { return essential.indexOf(s.type) !== -1; });

    if (missingEssential.length) {
      out.push({ level: 'warn', text: 'ناقص: ' + missingEssential.map(function (s) { return s.label; }).join('، ') });
    }

    // تعارضات فعلية بين القطع المختارة
    SLOTS.forEach(function (s) {
      var p = build[s.type];
      if (!p) return;
      var others = {};
      Object.keys(build).forEach(function (k) { if (k !== s.type) others[k] = build[k]; });
      var r = incompatibleReason(p, others);
      if (r) out.push({ level: 'err', text: s.label + ': ' + r, slot: s.type });
    });

    // كرت شاشة مطلوب
    if (build.cpu && build.cpu.igpu === false && !build.gpu) {
      out.push({ level: 'err', text: 'المعالج بدون كرت مدمج — لازم تختار كرت شاشة.' });
    }

    // الطاقة
    if (build.psu) {
      if (build.psu.watt < need) {
        out.push({ level: 'err', text: 'مزود الطاقة غير كافٍ — التجميعة تحتاج ' + need + ' واط تقريبًا.' });
      } else if (build.psu.watt < need * 1.1) {
        out.push({ level: 'warn', text: 'مزود الطاقة كافٍ بالكاد — يُفضّل قدرة أعلى للتوسع لاحقًا.' });
      }
    }

    if (!out.length && missing.length === 0) {
      out.push({ level: 'ok', text: 'التجميعة متوافقة بالكامل وجاهزة للطلب ✅' });
    }
    return out;
  }

  // ---------- الرسم ----------
  function renderSlots() {
    var wrap = document.getElementById('axb-slots');
    var issues = collectIssues();
    var badSlots = issues.filter(function (i) { return i.slot; }).map(function (i) { return i.slot; });

    wrap.innerHTML = '';
    SLOTS.forEach(function (s) {
      var p = build[s.type];
      var el = document.createElement('div');
      el.className = 'axb-slot' + (p ? ' is-filled' : '') + (badSlots.indexOf(s.type) !== -1 ? ' has-error' : '');
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');

      el.innerHTML = p
        ? '<img class="axb-slot__thumb" src="' + fallbackImg(p) + '" alt="" />' +
          '<div class="axb-slot__body">' +
            '<span class="axb-slot__label">' + s.label + '</span>' +
            '<div class="axb-slot__name">' + p.name + '</div>' +
          '</div>' +
          '<div class="axb-slot__price">' + money(p.price) + '</div>' +
          '<button class="axb-slot__clear" type="button" aria-label="إزالة">&times;</button>'
        : '<div class="axb-slot__icon">' + s.icon + '</div>' +
          '<div class="axb-slot__body">' +
            '<span class="axb-slot__label">' + s.label + '</span>' +
            '<div class="axb-slot__name is-empty">اضغط للاختيار</div>' +
            '<div class="axb-slot__meta">' + byType(s.type).length + ' خيار متاح</div>' +
          '</div>';

      el.addEventListener('click', function (ev) {
        if (ev.target.classList.contains('axb-slot__clear')) {
          ev.stopPropagation();
          delete build[s.type];
          save(); renderAll();
          return;
        }
        openModal(s.type);
      });
      el.addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); openModal(s.type); }
      });

      wrap.appendChild(el);
    });
  }

  function renderSummary() {
    var chosen = Object.keys(build).length;
    var total = Object.keys(build).reduce(function (a, k) { return a + build[k].price; }, 0);
    var watt = estimateWatt(build);
    var need = Math.round(watt * 1.3);

    document.getElementById('axb-progress-count').textContent = chosen + ' / ' + SLOTS.length;
    document.getElementById('axb-ring-fg').style.strokeDashoffset =
      String(119.4 - (119.4 * chosen / SLOTS.length));

    document.getElementById('axb-total').textContent = money(total);
    document.getElementById('axb-watt').textContent = watt + ' واط';

    var bar = document.querySelector('.axb-power__bar');
    var fill = document.getElementById('axb-watt-bar');
    var note = document.getElementById('axb-watt-note');
    bar.classList.remove('is-tight', 'is-over');

    if (build.psu) {
      var pct = Math.min(100, Math.round(watt / build.psu.watt * 100));
      fill.style.width = pct + '%';
      if (build.psu.watt < need) { bar.classList.add('is-over'); note.textContent = 'غير كافٍ — المطلوب ' + need + ' واط على الأقل'; }
      else if (build.psu.watt < need * 1.1) { bar.classList.add('is-tight'); note.textContent = 'كافٍ بالكاد — الموصى به ' + need + ' واط'; }
      else { note.textContent = 'ممتاز — هامش أمان جيد (' + build.psu.watt + ' واط)'; }
    } else {
      fill.style.width = Math.min(100, watt / 10) + '%';
      note.textContent = watt > 60 ? 'الموصى به: مزود ' + need + ' واط أو أعلى' : 'اختر مزود طاقة لمعرفة الكفاية';
    }

    var issues = collectIssues();
    document.getElementById('axb-issues').innerHTML = issues.map(function (i) {
      var icon = i.level === 'err' ? '✕' : (i.level === 'warn' ? '!' : '✓');
      return '<div class="axb-issue axb-issue--' + i.level + '"><span>' + icon + '</span><span>' + i.text + '</span></div>';
    }).join('');

    var hasError = issues.some(function (i) { return i.level === 'err'; });
    document.getElementById('axb-add-all').disabled = hasError || chosen === 0;
  }

  function renderAll() { renderSlots(); renderSummary(); }

  // ---------- النافذة ----------
  function openModal(type) {
    activeType = type;
    var slot = SLOTS.filter(function (s) { return s.type === type; })[0];
    document.getElementById('axb-modal-title').textContent = 'اختر ' + slot.label;
    document.getElementById('axb-search').value = '';
    document.getElementById('axb-modal').hidden = false;
    document.body.style.overflow = 'hidden';
    renderOptions();
  }

  function closeModal() {
    document.getElementById('axb-modal').hidden = true;
    document.body.style.overflow = '';
    activeType = null;
  }

  function specLine(p) {
    var bits = [];
    if (p.brand) bits.push(p.brand);
    if (p.socket) bits.push(p.socket);
    if (p.ram_type) bits.push(p.ram_type);
    if (p.form) bits.push(p.form);
    if (p.type === 'psu') bits.push(p.watt + ' واط');
    if (p.type === 'gpu' && p.length) bits.push(p.length + ' مم');
    if (p.type === 'cooler' && p.height) bits.push('ارتفاع ' + p.height + ' مم');
    return bits.join(' · ');
  }

  function renderOptions() {
    var list = document.getElementById('axb-modal-list');
    var q = document.getElementById('axb-search').value.trim().toLowerCase();
    var onlyCompatible = document.getElementById('axb-only-compatible').checked;

    var others = {};
    Object.keys(build).forEach(function (k) { if (k !== activeType) others[k] = build[k]; });

    var items = byType(activeType)
      .filter(function (p) {
        if (!q) return true;
        return (p.name + ' ' + (p.brand || '')).toLowerCase().indexOf(q) !== -1;
      })
      .map(function (p) { return { part: p, reason: incompatibleReason(p, others) }; })
      .filter(function (o) { return onlyCompatible ? !o.reason : true; })
      .sort(function (a, b) {
        if (!!a.reason !== !!b.reason) return a.reason ? 1 : -1;
        return a.part.price - b.part.price;
      });

    if (!items.length) {
      list.innerHTML = '<div class="axb-empty">ما فيه خيارات مطابقة.<br>جرّب إلغاء «المتوافق فقط» أو غيّر قطعة سابقة.</div>';
      return;
    }

    list.innerHTML = '';
    items.forEach(function (o) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'axb-option';
      if (o.reason) b.disabled = true;
      b.innerHTML =
        '<img class="axb-option__thumb" src="' + fallbackImg(o.part) + '" alt="" />' +
        '<div class="axb-option__body">' +
          '<div class="axb-option__name">' + o.part.name + '</div>' +
          '<div class="axb-option__spec">' + specLine(o.part) + '</div>' +
          (o.reason ? '<div class="axb-option__reason">✕ ' + o.reason + '</div>' : '') +
        '</div>' +
        '<div class="axb-option__price">' + money(o.part.price) + '</div>';

      b.addEventListener('click', function () {
        build[activeType] = o.part;
        save();
        closeModal();
        renderAll();
      });
      list.appendChild(b);
    });
  }

  // ---------- الحفظ المحلي ----------
  function save() {
    try {
      var ids = {};
      Object.keys(build).forEach(function (k) { ids[k] = build[k].id; });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    } catch (e) {}
  }
  function load() {
    try {
      var ids = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      Object.keys(ids).forEach(function (k) {
        var p = PARTS.filter(function (x) { return x.id === ids[k]; })[0];
        if (p) build[k] = p;
      });
    } catch (e) {}
  }

  // ---------- الإضافة للسلة (سلة) ----------
  document.getElementById('axb-add-all').addEventListener('click', function () {
    var btn = this;
    var items = Object.keys(build).map(function (k) { return build[k]; });
    if (!items.length) return;

    if (typeof salla === 'undefined' || !salla.cart) {
      console.warn('[ApexBuilder] Twilight SDK غير متاح — جرّب داخل المتجر.');
      return;
    }

    btn.classList.add('is-loading');
    btn.textContent = 'جاري الإضافة…';

    var chain = Promise.resolve();
    items.forEach(function (p) {
      chain = chain.then(function () {
        return salla.cart.addItem({ id: p.id, quantity: 1 });
      });
    });

    chain
      .then(function () {
        btn.textContent = 'تمت الإضافة ✓';
        if (salla.notify) salla.notify.success('تمت إضافة التجميعة إلى السلة');
        setTimeout(function () { window.location.href = '/cart'; }, 900);
      })
      .catch(function (err) {
        console.error('[ApexBuilder]', err);
        btn.classList.remove('is-loading');
        btn.textContent = 'أضف التجميعة للسلة';
        if (salla.notify) salla.notify.error('تعذّرت إضافة إحدى القطع — تحقق من توفرها');
      });
  });

  // ---------- ربط الأحداث ----------
  document.getElementById('axb-reset').addEventListener('click', function () {
    build = {};
    save();
    renderAll();
  });
  document.getElementById('axb-search').addEventListener('input', renderOptions);
  document.getElementById('axb-only-compatible').addEventListener('change', renderOptions);
  Array.prototype.forEach.call(root.querySelectorAll('[data-axb-close]'), function (el) {
    el.addEventListener('click', closeModal);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && activeType) closeModal();
  });

  // ---------- الإقلاع ----------
  load();
  renderAll();
})();
</script>

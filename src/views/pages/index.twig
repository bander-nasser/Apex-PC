{% extends "layouts.master" %}

{% block content %}

<main class="apex-home">

  {# Hero #}
  <section class="apex-home-hero">
    <div class="container">
      <div class="apex-home-hero__box">

        <div class="apex-home-hero__content">
          <span class="apex-home-hero__badge">أداء بلا حدود</span>

          <h1>
            أطلق العنان لقوتك
            <strong>مع تجميعتك المثالية</strong>
          </h1>

          <p>
            أحدث القطع، تجميع احترافي، أسعار تنافسية وضمان موثوق.
          </p>

          <div class="apex-home-hero__buttons">
            <a href="/products" class="apex-home-btn apex-home-btn--primary">
              تسوق الآن
            </a>

            <a href="#apex-budget" class="apex-home-btn apex-home-btn--budget">
              ابنِ حسب ميزانيتك
            </a>
          </div>

        </div>

        <div class="apex-home-hero__visual">
          <img
            src="{{ 'images/apex-hero-pc.png' | asset }}"
            alt="تجميعة ألعاب Apex PC"
          >
          <div class="apex-home-hero__glow"></div>
        </div>

      </div>
    </div>
  </section>

  {# ================= ابنِ حسب ميزانيتك ================= #}
  {#
     لتعديل الأسعار أو الأوصاف أو الروابط، عدّل داخل هذا القسم فقط.
  #}
  <section id="apex-budget" class="apex-home-section apex-budget-section">
    <div class="container">

      <div class="apex-home-heading">
        <div>
          <span>اختر ما يناسبك</span>
          <h2>ابنِ حسب ميزانيتك</h2>
        </div>
      </div>

      <p class="apex-budget-intro">
        اختر الفئة التي تناسب ميزانيتك، وتصفّح التجميعات الجاهزة داخلها.
        كل تجميعة مركّبة ومختبرة ومضمونة.
      </p>

      <div class="apex-budget-grid">

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%D9%8A%D8%A9/c729038447"
          class="apex-budget-card"
        >
          <span class="apex-budget-card__tier">اقتصادية</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>3,999</strong>
            <em>ر.س</em>
          </div>
          <p>بداية قوية للألعاب والاستخدام اليومي بأفضل قيمة مقابل السعر.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D9%85%D8%AA%D9%88%D8%B3%D8%B7%D8%A9/c1927395947"
          class="apex-budget-card apex-budget-card--featured"
        >
          <span class="apex-budget-card__flag">الأكثر طلبًا</span>
          <span class="apex-budget-card__tier">متوسطة</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>5,000</strong>
            <em>ر.س</em>
          </div>
          <p>توازن مثالي بين الأداء والسعر، تشغيل سلس على إعدادات عالية.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D8%AD%D8%AA%D8%B1%D8%A7%D9%81%D9%8A%D8%A9/c1288624500"
          class="apex-budget-card"
        >
          <span class="apex-budget-card__tier">احترافية</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>8,000</strong>
            <em>ر.س</em>
          </div>
          <p>أداء عالٍ للألعاب التنافسية وصناعة المحتوى والبث المباشر.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

      </div>
    </div>
  </section>

  <style>
    .apex-budget-intro{
      max-width: 60ch;
      margin: 0 0 32px;
      opacity: .75;
      line-height: 1.8;
    }

    .apex-budget-grid{
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    @media (max-width: 900px){
      .apex-budget-grid{ grid-template-columns: 1fr; }
    }

    .apex-budget-card{
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 30px 26px;
      border-radius: 20px;
      text-decoration: none;
      color: inherit;
      background: linear-gradient(160deg, rgba(139,92,246,.10), rgba(139,92,246,.02));
      border: 1px solid rgba(139,92,246,.22);
      transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
    }
    .apex-budget-card:hover{
      transform: translateY(-6px);
      border-color: rgba(167,139,250,.65);
      box-shadow: 0 18px 44px rgba(109,40,217,.28);
    }

    .apex-budget-card--featured{
      background: linear-gradient(160deg, rgba(139,92,246,.24), rgba(139,92,246,.06));
      border-color: rgba(167,139,250,.55);
    }

    .apex-budget-card__flag{
      position: absolute;
      top: 16px;
      inset-inline-start: 22px;
      font-size: 11px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 99px;
      background: #8B5CF6;
      color: #fff;
    }

    .apex-budget-card__tier{
      font-size: 19px;
      font-weight: 800;
      margin-bottom: 14px;
    }

    .apex-budget-card__price{
      display: flex;
      align-items: baseline;
      gap: 7px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .apex-budget-card__price span{ font-size: 13px; opacity: .6; }
    .apex-budget-card__price strong{
      font-size: 36px;
      font-weight: 800;
      line-height: 1;
      color: #C4B5FD;
    }
    .apex-budget-card__price em{ font-style: normal; font-size: 15px; opacity: .8; }

    .apex-budget-card p{
      font-size: 14px;
      line-height: 1.85;
      opacity: .72;
      margin: 0 0 24px;
      flex: 1;
    }

    .apex-budget-card__cta{
      display: inline-block;
      align-self: flex-start;
      padding: 11px 22px;
      border-radius: 11px;
      font-size: 14px;
      font-weight: 700;
      background: rgba(139,92,246,.18);
      border: 1px solid rgba(167,139,250,.45);
      transition: background .25s ease;
    }
    .apex-budget-card:hover .apex-budget-card__cta{
      background: #8B5CF6;
      color: #fff;
    }
  </style>

  {# Categories #}
  <section id="apex-categories" class="apex-home-section">
    <div class="container">

      <div class="apex-home-heading">
        <div>
          <span>اكتشف خدماتنا</span>
          <h2>التصنيفات الرئيسية</h2>
        </div>
      </div>

      <div class="apex-category-grid">

        <a href="/products" class="apex-category-card">
          <div class="apex-category-card__icon">🖥️</div>
          <h3>تجميعات PC</h3>
          <p>تجميعات احترافية حسب الطلب</p>
        </a>

        <a href="/products" class="apex-category-card">
          <div class="apex-category-card__icon">🎮</div>
          <h3>تجميعات جاهزة</h3>
          <p>خيارات جاهزة للألعاب والعمل</p>
        </a>

        <a href="/products" class="apex-category-card">
          <div class="apex-category-card__icon">🧩</div>
          <h3>المكونات</h3>
          <p>قطع أصلية بأداء موثوق</p>
        </a>

        <a href="/products" class="apex-category-card">
          <div class="apex-category-card__icon">🎧</div>
          <h3>الملحقات</h3>
          <p>كل ما تحتاجه لتجربة متكاملة</p>
        </a>

        <a href="/contact" class="apex-category-card">
          <div class="apex-category-card__icon">🛠️</div>
          <h3>الصيانة</h3>
          <p>فحص وصيانة احترافية</p>
        </a>

        <a href="/contact" class="apex-category-card">
          <div class="apex-category-card__icon">⚡</div>
          <h3>الترقية</h3>
          <p>طور جهازك بأحدث القطع</p>
        </a>

        <a href="/contact" class="apex-category-card">
          <div class="apex-category-card__icon">🎙️</div>
          <h3>الدعم الفني</h3>
          <p>مساعدة سريعة وحلول احترافية</p>
        </a>

      </div>
    </div>
  </section>

  {# Weekly offer #}
  <section class="apex-home-section apex-weekly-section">
    <div class="container">
      <div class="apex-weekly-grid">

        <div class="apex-countdown-card">
          <span class="apex-countdown-card__label">عرض محدود</span>
          <h2>عرض الأسبوع</h2>
          <p>ينتهي العرض خلال:</p>

          <div class="apex-countdown">
            <div>
              <strong>02</strong>
              <span>أيام</span>
            </div>

            <div>
              <strong>14</strong>
              <span>ساعات</span>
            </div>

            <div>
              <strong>38</strong>
              <span>دقائق</span>
            </div>

            <div>
              <strong>59</strong>
              <span>ثواني</span>
            </div>
          </div>

          <a href="/products" class="apex-home-btn apex-home-btn--primary">
            مشاهدة العروض
          </a>
        </div>

        <div class="apex-featured-offer">

          <div class="apex-featured-offer__image">
            <img
              src="{{ 'images/apex-logo.png' | asset }}"
              alt="Apex PC weekly offer"
            >
          </div>

          <div class="apex-featured-offer__content">
            <span class="apex-featured-offer__discount">خصم 15%</span>

            <h2>تجميعة Apex Ultra</h2>
            <p>أداء قوي للألعاب والعمل وصناعة المحتوى.</p>

            <div class="apex-featured-offer__specs">
              <span>Intel Core i7</span>
              <span>RTX Graphics</span>
              <span>32GB DDR5</span>
              <span>2TB NVMe</span>
            </div>

            <div class="apex-featured-offer__price">
              <del>6,799 ر.س</del>
              <strong>5,749 ر.س</strong>
            </div>

            <a href="/products" class="apex-home-btn apex-home-btn--primary">
              أضف إلى السلة
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

  {# Brands #}
  <section class="apex-home-section">
    <div class="container">

      <div class="apex-home-heading">
        <div>
          <span>شركاؤنا</span>
          <h2>الماركات المعتمدة</h2>
        </div>
      </div>

      <div class="apex-brands-grid">
        <div>ASUS</div>
        <div>MSI</div>
        <div>Intel</div>
        <div>AMD</div>
        <div>NVIDIA</div>
        <div>Corsair</div>
        <div>Gigabyte</div>
        <div>NZXT</div>
        <div>HyperX</div>
        <div>Logitech</div>
      </div>

    </div>
  </section>

  {# Existing Salla products and dynamic components #}
  <section class="apex-home-section apex-best-sellers">
    <div class="container">
      <div class="apex-home-heading">
        <div>
          <span>اختيارات العملاء</span>
          <h2>الأكثر مبيعًا</h2>
        </div>

        <a href="/products" class="apex-section-link">
          عرض جميع المنتجات
        </a>
      </div>
    </div>

    <div class="apex-salla-components">
      {% component home %}
    </div>
  </section>

  {# Reviews #}
  <section class="apex-home-section apex-reviews-section">
    <div class="container">

      <div class="apex-home-heading">
        <div>
          <span>آراء حقيقية</span>
          <h2>تقييمات العملاء</h2>
        </div>
      </div>

      <div class="apex-reviews-grid">

        <article class="apex-review-card">
          <div class="apex-review-card__stars">★★★★★</div>
          <p>
            التجميعة وصلت مرتبة وأداء الجهاز ممتاز، والدعم الفني كان سريعًا
            ومتعاونًا.
          </p>
          <div class="apex-review-card__customer">
            <strong>أحمد العتيبي</strong>
            <span>الرياض</span>
          </div>
        </article>

        <article class="apex-review-card">
          <div class="apex-review-card__stars">★★★★★</div>
          <p>
            جودة عالية وتغليف ممتاز، واستلمت الطلب في الموعد بدون أي مشكلة.
          </p>
          <div class="apex-review-card__customer">
            <strong>سارة القحطاني</strong>
            <span>جدة</span>
          </div>
        </article>

        <article class="apex-review-card">
          <div class="apex-review-card__stars">★★★★★</div>
          <p>
            أسعار مناسبة وخدمة احترافية، وتم اختيار القطع المناسبة لميزانيتي.
          </p>
          <div class="apex-review-card__customer">
            <strong>محمد الشهري</strong>
            <span>الدمام</span>
          </div>
        </article>

      </div>
    </div>
  </section>

</main>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}

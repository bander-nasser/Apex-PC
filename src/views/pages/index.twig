{% extends "layouts.master" %}

{% block content %}

<main class="apex-home">

  {# ==================== Hero (داكن) ==================== #}
  <section class="apex-home-hero">
    <div class="container">
      <div class="apex-home-hero__box">

        <div class="apex-home-hero__content">
          <span class="apex-home-hero__badge">أداء بلا حدود</span>

          <h1>
            أطلق العنان لقوتك
            <strong>مع تجميعتك المثالية</strong>
          </h1>

          <p>
            أحدث القطع، تجميع احترافي، أسعار تنافسية وضمان موثوق.
          </p>

          <div class="apex-home-hero__buttons">
            <a href="/products" class="apex-home-btn apex-home-btn--primary">
              تسوق الآن
            </a>

            <a href="#apex-budget" class="apex-home-btn apex-home-btn--budget">
              ابنِ حسب ميزانيتك
            </a>
          </div>

        </div>

        <div class="apex-home-hero__visual">
          <img
            src="{{ 'images/apex-hero-pc.png' | asset }}"
            alt="تجميعة ألعاب Apex PC"
          >
          <div class="apex-home-hero__glow"></div>
        </div>

      </div>
    </div>
  </section>

  {# ==================== ابنِ حسب ميزانيتك (داكن) ==================== #}
  <section id="apex-budget" class="apex-sec apex-sec--dark">
    <div class="container">

      <div class="apex-head">
        <span>اختر ما يناسبك</span>
        <h2>ابنِ حسب ميزانيتك</h2>
      </div>

      <p class="apex-budget-intro">
        اختر الفئة التي تناسب ميزانيتك، وتصفّح التجميعات الجاهزة داخلها.
        كل تجميعة مركّبة ومختبرة ومضمونة.
      </p>

      <div class="apex-budget-grid">

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%D9%8A%D8%A9/c729038447"
          class="apex-budget-card"
        >
          <span class="apex-budget-card__tier">اقتصادية</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>3,999</strong>
            <em>ر.س</em>
          </div>
          <p>بداية قوية للألعاب والاستخدام اليومي بأفضل قيمة مقابل السعر.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D9%85%D8%AA%D9%88%D8%B3%D8%B7%D8%A9/c1927395947"
          class="apex-budget-card apex-budget-card--featured"
        >
          <span class="apex-budget-card__flag">الأكثر طلبًا</span>
          <span class="apex-budget-card__tier">متوسطة</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>5,000</strong>
            <em>ر.س</em>
          </div>
          <p>توازن مثالي بين الأداء والسعر، تشغيل سلس على إعدادات عالية.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D8%AD%D8%AA%D8%B1%D8%A7%D9%81%D9%8A%D8%A9/c1288624500"
          class="apex-budget-card"
        >
          <span class="apex-budget-card__tier">احترافية</span>
          <div class="apex-budget-card__price">
            <span>تبدأ من</span>
            <strong>8,000</strong>
            <em>ر.س</em>
          </div>
          <p>أداء عالٍ للألعاب التنافسية وصناعة المحتوى والبث المباشر.</p>
          <span class="apex-budget-card__cta">تصفّح التجميعات</span>
        </a>

      </div>
    </div>
  </section>

  {# ==================== التصنيفات (فاتح) ==================== #}
  <section id="apex-categories" class="apex-sec apex-sec--light">
    <div class="container">

      <div class="apex-head">
        <span>اكتشف خدماتنا</span>
        <h2>التصنيفات الرئيسية</h2>
      </div>

      <div class="apex-cat-grid">

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%D9%8A%D8%A9/c729038447"
          class="apex-cat"
        >
          <span class="apex-cat__icon">💻</span>
          <h3>تجميعات اقتصادية</h3>
          <p>أفضل قيمة مقابل السعر</p>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D9%85%D8%AA%D9%88%D8%B3%D8%B7%D8%A9/c1927395947"
          class="apex-cat"
        >
          <span class="apex-cat__icon">🎮</span>
          <h3>تجميعات متوسطة</h3>
          <p>أداء متوازن للألعاب</p>
        </a>

        <a
          href="https://apexpc.store/ar/%D8%AA%D8%AC%D9%85%D9%8A%D8%B9%D8%A7%D8%AA%20%D8%A5%D8%AD%D8%AA%D8%B1%D8%A7%D9%81%D9%8A%D8%A9/c1288624500"
          class="apex-cat"
        >
          <span class="apex-cat__icon">🚀</span>
          <h3>تجميعات احترافية</h3>
          <p>للألعاب التنافسية والمونتاج</p>
        </a>

        <a href="/products" class="apex-cat">
          <span class="apex-cat__icon">🧩</span>
          <h3>المكونات</h3>
          <p>قطع أصلية بأداء موثوق</p>
        </a>

        <a href="/products" class="apex-cat">
          <span class="apex-cat__icon">🎧</span>
          <h3>الملحقات</h3>
          <p>كل ما تحتاجه لتجربة متكاملة</p>
        </a>

        <a href="/contact" class="apex-cat">
          <span class="apex-cat__icon">🛠️</span>
          <h3>الصيانة والترقية</h3>
          <p>فحص وصيانة وتطوير احترافي</p>
        </a>

      </div>
    </div>
  </section>

  {# ==================== عرض الأسبوع (داكن) ==================== #}
  <section class="apex-sec apex-sec--dark">
    <div class="container">
      <div class="apex-weekly">

        <div class="apex-weekly__text">
          <span class="apex-weekly__label">عرض محدود</span>
          <h2>عرض الأسبوع</h2>
          <p>ينتهي العرض خلال:</p>

          <div class="apex-countdown" id="apexCountdown">
            <div><strong data-cd="days">--</strong><span>أيام</span></div>
            <div><strong data-cd="hours">--</strong><span>ساعات</span></div>
            <div><strong data-cd="mins">--</strong><span>دقائق</span></div>
            <div><strong data-cd="secs">--</strong><span>ثواني</span></div>
          </div>

          <a
            href="https://apexpc.store/ar/%D8%B9%D8%B1%D9%88%D8%B6%20%D8%A7%D9%84%D8%A3%D8%B3%D8%A8%D9%88%D8%B9/c1411183504"
            class="apex-home-btn apex-home-btn--primary"
          >
            مشاهدة كل العروض
          </a>
        </div>

        <div class="apex-weekly__glow"></div>

      </div>

      {# منتجات تصنيف «عروض الأسبوع» — تتحدث تلقائيًا من لوحة سلة #}
      <div class="apex-weekly-products">
        <salla-products-list
          source="categories"
          source-value="[1411183504]"
          limit="4"
        ></salla-products-list>
      </div>

    </div>
  </section>

  {# ==================== الماركات (فاتح) ==================== #}
  <section class="apex-sec apex-sec--light">
    <div class="container">
      <div class="apex-head">
        <span>شركاؤنا</span>
        <h2>الماركات المعتمدة</h2>
      </div>
    </div>

    <div class="apex-marquee">
      <div class="apex-marquee__track">
        {% for i in 1..2 %}
          <div class="apex-marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
            <img src="{{ 'images/brands/asus.png'     | asset }}" alt="ASUS">
            <img src="{{ 'images/brands/msi.png'      | asset }}" alt="MSI">
            <img src="{{ 'images/brands/intel.png'    | asset }}" alt="Intel">
            <img src="{{ 'images/brands/amd.png'      | asset }}" alt="AMD">
            <img src="{{ 'images/brands/nvidia.png'   | asset }}" alt="NVIDIA">
            <img src="{{ 'images/brands/corsair.png'  | asset }}" alt="Corsair">
            <img src="{{ 'images/brands/gigabyte.png' | asset }}" alt="Gigabyte">
            <img src="{{ 'images/brands/nzxt.png'     | asset }}" alt="NZXT">
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# ==================== الأكثر مبيعًا (فاتح) ==================== #}
  <section class="apex-sec apex-sec--light apex-best-sellers">
    <div class="container">
      <div class="apex-head apex-head--row">
        <div>
          <span>اختيارات العملاء</span>
          <h2>الأكثر مبيعًا</h2>
        </div>

        <a href="/products" class="apex-section-link">
          عرض جميع المنتجات
        </a>
      </div>
    </div>

    <div class="apex-salla-components">
      {% component home %}
    </div>
  </section>

  {# ==================== آراء العملاء (داكن) ==================== #}
  <section class="apex-sec apex-sec--dark">
    <div class="container">

      <div class="apex-head">
        <span>آراء حقيقية</span>
        <h2>آراء العملاء</h2>
      </div>

      <div class="apex-reviews">

        <article class="apex-review">
          <div class="apex-review__stars">★★★★★</div>
          <p>
            التجميعة وصلت مرتبة وأداء الجهاز ممتاز، والدعم الفني كان سريعًا
            ومتعاونًا.
          </p>
          <div class="apex-review__who">
            <strong>أحمد العتيبي</strong>
            <span>الرياض</span>
          </div>
        </article>

        <article class="apex-review">
          <div class="apex-review__stars">★★★★★</div>
          <p>
            جودة عالية وتغليف ممتاز، واستلمت الطلب في الموعد بدون أي مشكلة.
          </p>
          <div class="apex-review__who">
            <strong>سارة القحطاني</strong>
            <span>جدة</span>
          </div>
        </article>

        <article class="apex-review">
          <div class="apex-review__stars">★★★★★</div>
          <p>
            أسعار مناسبة وخدمة احترافية، وتم اختيار القطع المناسبة لميزانيتي.
          </p>
          <div class="apex-review__who">
            <strong>محمد الشهري</strong>
            <span>الدمام</span>
          </div>
        </article>

      </div>
    </div>
  </section>

  {# ==================== الوثيقة + الروابط (فاتح) ==================== #}
  <section class="apex-sec apex-sec--light">
    <div class="container">

      <div class="apex-doc">
        <img
          class="apex-doc__logo"
          src="{{ 'images/freelance.png' | asset }}"
          alt="وثيقة العمل الحر"
        >
        <div class="apex-doc__text">
          <strong>موثّق بوثيقة العمل الحر</strong>
          <span>رقم الوثيقة: 710447014</span>
        </div>
      </div>

      <div class="apex-head apex-head--tight">
        <span>تعرّف علينا</span>
        <h2>روابط مهمة</h2>
      </div>

      <div class="apex-links">
        {% for p in store.pages %}
          <a href="{{ p.url }}" class="apex-links__item">{{ p.title }}</a>
        {% endfor %}
      </div>

    </div>
  </section>

</main>

<style>
  /* ============ أقسام متناوبة ============ */
  .apex-sec{ padding:72px 0; }
  .apex-sec--dark{ background:#120C24; color:#EDE9F7; }
  .apex-sec--light{ background:#F7F5FC; color:#1B1430; }

  .apex-head{ margin-bottom:34px; }
  .apex-head > span{
    display:block; font-size:13px; font-weight:700;
    letter-spacing:.06em; color:#8B5CF6; margin-bottom:8px;
  }
  .apex-head h2{ margin:0; font-size:clamp(24px,3.4vw,32px); font-weight:800; }
  .apex-head--row{ display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .apex-head--tight{ margin-top:52px; }

  /* ============ ابنِ حسب ميزانيتك ============ */
  .apex-budget-intro{ max-width:60ch; margin:-14px 0 32px; opacity:.72; line-height:1.85; }

  .apex-budget-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  @media (max-width:900px){ .apex-budget-grid{ grid-template-columns:1fr; } }

  .apex-budget-card{
    position:relative; display:flex; flex-direction:column;
    padding:30px 26px; border-radius:20px; text-decoration:none; color:inherit;
    background:linear-gradient(160deg,rgba(139,92,246,.14),rgba(139,92,246,.03));
    border:1px solid rgba(139,92,246,.26);
    transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
  }
  .apex-budget-card:hover{
    transform:translateY(-6px); border-color:rgba(167,139,250,.7);
    box-shadow:0 18px 44px rgba(109,40,217,.3);
  }
  .apex-budget-card--featured{
    background:linear-gradient(160deg,rgba(139,92,246,.28),rgba(139,92,246,.07));
    border-color:rgba(167,139,250,.6);
  }
  .apex-budget-card__flag{
    position:absolute; top:16px; inset-inline-start:22px;
    font-size:11px; font-weight:700; padding:5px 12px; border-radius:99px;
    background:#8B5CF6; color:#fff;
  }
  .apex-budget-card__tier{ font-size:19px; font-weight:800; margin-bottom:14px; }
  .apex-budget-card__price{ display:flex; align-items:baseline; gap:7px; margin-bottom:16px; flex-wrap:wrap; }
  .apex-budget-card__price span{ font-size:13px; opacity:.6; }
  .apex-budget-card__price strong{ font-size:36px; font-weight:800; line-height:1; color:#C4B5FD; }
  .apex-budget-card__price em{ font-style:normal; font-size:15px; opacity:.8; }
  .apex-budget-card p{ font-size:14px; line-height:1.85; opacity:.72; margin:0 0 24px; flex:1; }
  .apex-budget-card__cta{
    display:inline-block; align-self:flex-start; padding:11px 22px; border-radius:11px;
    font-size:14px; font-weight:700;
    background:rgba(139,92,246,.2); border:1px solid rgba(167,139,250,.5);
    transition:background .25s ease;
  }
  .apex-budget-card:hover .apex-budget-card__cta{ background:#8B5CF6; color:#fff; }

  /* ============ التصنيفات (على فاتح) ============ */
  .apex-cat-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  @media (max-width:900px){ .apex-cat-grid{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:560px){ .apex-cat-grid{ grid-template-columns:1fr; } }

  .apex-cat{
    display:block; padding:26px 22px; border-radius:18px; text-decoration:none;
    background:#fff; border:1px solid #E6E1F2;
    transition:transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }
  .apex-cat:hover{
    transform:translateY(-4px);
    border-color:#8B5CF6;
    box-shadow:0 14px 32px rgba(109,40,217,.12);
  }
  .apex-cat__icon{
    display:grid; place-items:center; width:52px; height:52px; margin-bottom:16px;
    font-size:24px; border-radius:14px; background:#F1ECFD;
  }
  .apex-cat h3{ margin:0 0 6px; font-size:17px; font-weight:700; color:#1B1430; }
  .apex-cat p{ margin:0; font-size:13.5px; line-height:1.7; color:#6B6285; }

  /* ============ عرض الأسبوع ============ */
  .apex-weekly{
    position:relative; overflow:hidden; border-radius:24px; padding:44px 38px;
    background:linear-gradient(135deg,#1E1338,#2A1650);
    border:1px solid rgba(167,139,250,.3);
  }
  .apex-weekly__text{ position:relative; z-index:2; max-width:640px; }
  .apex-weekly__label{
    display:inline-block; font-size:12px; font-weight:700; padding:6px 14px;
    border-radius:99px; background:#8B5CF6; color:#fff; margin-bottom:14px;
  }
  .apex-weekly h2{ margin:0 0 6px; font-size:30px; font-weight:800; }
  .apex-weekly p{ margin:0 0 22px; opacity:.75; }
  .apex-weekly__glow{
    position:absolute; inset-inline-end:-90px; top:-90px;
    width:340px; height:340px; border-radius:50%;
    background:radial-gradient(circle,rgba(139,92,246,.55),transparent 68%);
    z-index:1; pointer-events:none;
  }

  .apex-countdown{ display:flex; gap:12px; margin-bottom:26px; flex-wrap:wrap; }
  .apex-countdown > div{
    min-width:78px; padding:14px 10px; text-align:center; border-radius:14px;
    background:rgba(0,0,0,.3); border:1px solid rgba(167,139,250,.28);
  }
  .apex-countdown strong{
    display:block; font-size:28px; font-weight:800; line-height:1;
    color:#C4B5FD; font-variant-numeric:tabular-nums;
  }
  .apex-countdown span{ font-size:12px; opacity:.65; }

  .apex-weekly-products{ margin-top:28px; }
  .apex-weekly-products salla-products-list{ display:block; }

  /* ============ شريط الماركات ============ */
  .apex-marquee{
    overflow:hidden; padding:18px 0; margin-top:6px;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
  }
  .apex-marquee__track{ display:flex; width:max-content; animation:apexScroll 34s linear infinite; }
  .apex-marquee:hover .apex-marquee__track{ animation-play-state:paused; }
  .apex-marquee__group{ display:flex; align-items:center; gap:60px; padding-inline-end:60px; }
  .apex-marquee__group img{
    height:40px; width:auto; object-fit:contain;
    /* يذوّب الخلفية البيضاء للشعارات على الخلفية الفاتحة */
    mix-blend-mode:multiply;
    opacity:.62; filter:grayscale(1);
    transition:opacity .3s ease, filter .3s ease;
  }
  .apex-marquee__group img:hover{ opacity:1; filter:none; }

  @keyframes apexScroll{
    from{ transform:translateX(0); }
    to  { transform:translateX(-50%); }
  }
  @media (prefers-reduced-motion:reduce){ .apex-marquee__track{ animation:none; } }

  /* ============ آراء العملاء (على داكن) ============ */
  .apex-reviews{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  @media (max-width:900px){ .apex-reviews{ grid-template-columns:1fr; } }

  .apex-review{
    padding:26px 24px; border-radius:18px;
    background:rgba(255,255,255,.04);
    border:1px solid rgba(139,92,246,.22);
  }
  .apex-review__stars{ color:#FBBF24; font-size:15px; letter-spacing:2px; margin-bottom:12px; }
  .apex-review p{ margin:0 0 20px; font-size:14.5px; line-height:1.9; opacity:.8; }
  .apex-review__who{
    display:flex; flex-direction:column; gap:3px;
    padding-top:16px; border-top:1px solid rgba(255,255,255,.08);
  }
  .apex-review__who strong{ font-size:14.5px; font-weight:700; }
  .apex-review__who span{ font-size:12.5px; opacity:.55; }

  /* ============ وثيقة العمل الحر ============ */
  .apex-doc{
    display:flex; align-items:center; gap:18px; flex-wrap:wrap;
    padding:22px 26px; border-radius:18px;
    background:#fff; border:1px solid #E6E1F2;
  }
  .apex-doc__logo{ height:56px; width:auto; object-fit:contain; }
  .apex-doc__text{ display:flex; flex-direction:column; gap:4px; }
  .apex-doc__text strong{ font-size:16px; font-weight:700; color:#1B1430; }
  .apex-doc__text span{ font-size:13px; color:#6B6285; font-variant-numeric:tabular-nums; }

  /* ============ روابط الصفحات ============ */
  .apex-links{ display:flex; flex-wrap:wrap; gap:12px; }
  .apex-links__item{
    padding:11px 20px; border-radius:11px; font-size:14px; text-decoration:none;
    color:#1B1430; background:#fff; border:1px solid #E6E1F2;
    transition:background .22s ease, border-color .22s ease, color .22s ease;
  }
  .apex-links__item:hover{ background:#8B5CF6; border-color:#8B5CF6; color:#fff; }
</style>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'home.js' | asset }}"></script>

  <script>
    // مؤقت أسبوعي: يعدّ حتى نهاية الأسبوع ثم يبدأ من جديد تلقائيًا
    (function () {
      var box = document.getElementById('apexCountdown');
      if (!box) return;

      var out = {
        days:  box.querySelector('[data-cd="days"]'),
        hours: box.querySelector('[data-cd="hours"]'),
        mins:  box.querySelector('[data-cd="mins"]'),
        secs:  box.querySelector('[data-cd="secs"]')
      };

      function pad(n) { return n < 10 ? '0' + n : String(n); }

      function nextReset() {
        var now = new Date();
        var d = new Date(now);
        d.setHours(0, 0, 0, 0);
        // 6 = السبت. غيّر الرقم لتغيير يوم انتهاء العرض (0 = الأحد)
        var diff = (6 - now.getDay() + 7) % 7 || 7;
        d.setDate(d.getDate() + diff);
        return d;
      }

      function tick() {
        var left = nextReset() - new Date();
        if (left < 0) left = 0;

        var s = Math.floor(left / 1000);
        out.days.textContent  = pad(Math.floor(s / 86400));
        out.hours.textContent = pad(Math.floor(s % 86400 / 3600));
        out.mins.textContent  = pad(Math.floor(s % 3600 / 60));
        out.secs.textContent  = pad(s % 60);
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
{% endblock %}

{% extends "layouts.master" %}

{% block content %}
  <main style="padding:60px 20px; min-height:600px; background:#0b0714; color:#fff;">
    <div class="container">
      <h1 style="font-size:40px; color:#a855f7;">
        اختبار صفحة Apex يعمل
      </h1>

      <p style="font-size:20px;">
        عنوان الصفحة: {{ page.title }}
      </p>

      <p style="font-size:16px;">
        محتوى الصفحة: {{ page.content|raw }}
      </p>
    </div>
  </main>
{% endblock %}
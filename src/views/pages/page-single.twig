{% extends "layouts.master" %}

{% extends "layouts.master" %}

{% block content %}
{% if page.id %}
        {% include 'components.pc-builder' %}

    {% else %}

    <main class="container py-10">
        {% component breadcrumbs %}
        <article class="content-entry">
            <h1>{{ page.title }}</h1>
            <div>{{ page.content|raw }}</div>
        </article>
    </main>

    {% endif %}
{% endblock %}
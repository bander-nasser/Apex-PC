{% extends "layouts.master" %}

{% block content %}

 {% set page_content = page.content|default('') %}

{% if 'APEX_PC_BUILDER' in page_content %}
    <main class="apex-builder-page" id="apex-pc-builder">
      <div class="container">

        <div class="apex-builder-hero">
          <span class="apex-builder-badge">APEX PC BUILDER</span>
          <h1>ابنِ تجميعتك</h1>
          <p>
            اختر القطع المناسبة، وسنتحقق من التوافق ونحسب السعر الإجمالي مباشرة.
          </p>
        </div>

        <div class="apex-builder-layout">

          <section class="apex-builder-parts">

            <div class="apex-builder-step" data-part="cpu">
              <div class="apex-builder-step__number">1</div>
              <div class="apex-builder-step__content">
                <h2>المعالج</h2>
                <p>اختر المعالج المناسب لاستخدامك.</p>
                <select id="builder-cpu">
                  <option value="">اختر المعالج</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="motherboard">
              <div class="apex-builder-step__number">2</div>
              <div class="apex-builder-step__content">
                <h2>اللوحة الأم</h2>
                <p>ستظهر اللوحات المتوافقة مع المعالج.</p>
                <select id="builder-motherboard" disabled>
                  <option value="">اختر اللوحة الأم</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="gpu">
              <div class="apex-builder-step__number">3</div>
              <div class="apex-builder-step__content">
                <h2>كرت الشاشة</h2>
                <p>اختر مستوى الأداء المناسب للألعاب أو التصميم.</p>
                <select id="builder-gpu">
                  <option value="">اختر كرت الشاشة</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="ram">
              <div class="apex-builder-step__number">4</div>
              <div class="apex-builder-step__content">
                <h2>الذاكرة</h2>
                <p>سنطابق نوع DDR مع اللوحة الأم.</p>
                <select id="builder-ram" disabled>
                  <option value="">اختر الذاكرة</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="storage">
              <div class="apex-builder-step__number">5</div>
              <div class="apex-builder-step__content">
                <h2>التخزين</h2>
                <p>اختر سعة ونوع التخزين.</p>
                <select id="builder-storage">
                  <option value="">اختر التخزين</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="cooler">
              <div class="apex-builder-step__number">6</div>
              <div class="apex-builder-step__content">
                <h2>التبريد</h2>
                <p>سنراجع توافق التبريد مع المعالج والكيس.</p>
                <select id="builder-cooler" disabled>
                  <option value="">اختر نظام التبريد</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="psu">
              <div class="apex-builder-step__number">7</div>
              <div class="apex-builder-step__content">
                <h2>مزود الطاقة</h2>
                <p>ستظهر القدرة المناسبة للتجميعة.</p>
                <select id="builder-psu" disabled>
                  <option value="">اختر مزود الطاقة</option>
                </select>
              </div>
            </div>

            <div class="apex-builder-step" data-part="case">
              <div class="apex-builder-step__number">8</div>
              <div class="apex-builder-step__content">
                <h2>الكيس</h2>
                <p>سنراجع حجم اللوحة وطول كرت الشاشة.</p>
                <select id="builder-case" disabled>
                  <option value="">اختر الكيس</option>
                </select>
              </div>
            </div>

          </section>

          <aside class="apex-builder-summary">

            <div class="apex-builder-summary__header">
              <h2>ملخص التجميعة</h2>
              <span id="builder-status" class="apex-builder-status is-pending">
                بانتظار الاختيارات
              </span>
            </div>

            <div id="builder-selected-parts" class="apex-builder-selected">
              <p class="apex-builder-empty">
                لم يتم اختيار أي قطعة بعد.
              </p>
            </div>

            <div class="apex-builder-power">
              <span>استهلاك الطاقة المتوقع</span>
              <strong id="builder-wattage">0 واط</strong>
            </div>

            <div class="apex-builder-total">
              <span>الإجمالي</span>
              <strong>
                <span id="builder-total">0</span>
                ر.س
              </strong>
            </div>

            <div id="builder-warning" class="apex-builder-warning" hidden></div>

            <button
              type="button"
              id="builder-add-cart"
              class="apex-builder-submit"
              disabled
            >
              أضف التجميعة إلى السلة
            </button>

            <p class="apex-builder-note">
              السعر النهائي والتوفر يتأكد عند إضافة القطع إلى السلة.
            </p>

          </aside>

        </div>
      </div>
    </main>

{% elseif 'APEX_BUDGET_BUILDER' in page_content %}
    <main class="apex-budget-page" id="apex-budget-builder">
      <div class="container">

        <div class="apex-builder-hero">
          <span class="apex-builder-badge">APEX SMART BUILDER</span>
          <h1>ابنِ حسب ميزانيتك</h1>
          <p>
            حدد ميزانيتك واستخدامك، وسنقترح لك تجميعة متوافقة.
          </p>
        </div>

        <section class="apex-budget-form">

          <div class="apex-budget-field">
            <label for="budget-amount">ميزانيتك</label>
            <input
              id="budget-amount"
              type="number"
              min="3000"
              max="30000"
              step="100"
              placeholder="مثال: 7000"
            >
            <span>بالريال السعودي</span>
          </div>

          <div class="apex-budget-field">
            <label for="budget-purpose">الاستخدام</label>
            <select id="budget-purpose">
              <option value="">اختر الاستخدام</option>
              <option value="gaming">ألعاب</option>
              <option value="streaming">ألعاب وبث</option>
              <option value="design">تصميم ومونتاج</option>
              <option value="workstation">أعمال احترافية</option>
            </select>
          </div>

          <div class="apex-budget-field">
            <label for="budget-resolution">الدقة المطلوبة</label>
            <select id="budget-resolution">
              <option value="">اختر الدقة</option>
              <option value="1080p">1080p</option>
              <option value="1440p">1440p</option>
              <option value="4k">4K</option>
            </select>
          </div>

          <button type="button" id="budget-generate">
            اقترح تجميعة
          </button>

        </section>

        <section id="budget-result" class="apex-budget-result" hidden>
          <div class="apex-budget-result__header">
            <div>
              <span>التجميعة المقترحة</span>
              <h2 id="budget-build-title">تجميعتك المناسبة</h2>
            </div>

            <strong>
              <span id="budget-build-total">0</span>
              ر.س
            </strong>
          </div>

          <div id="budget-build-parts" class="apex-budget-parts"></div>

          <div class="apex-budget-actions">
            <button type="button" id="budget-add-cart">
              أضف التجميعة إلى السلة
            </button>

            <button type="button" id="budget-edit-build">
              عدّل التجميعة
            </button>
          </div>
        </section>

      </div>
    </main>

  {% else %}

    <main class="container py-10">
      {% component breadcrumbs %}
      <article class="content-entry">
        <h1>{{ page.title }}</h1>
        <div>{{ page.content|raw }}</div>
      </article>
    </main>

  {% endif %}

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'apex-builder.js' | asset }}"></script>
{% endblock %}